# Public address. Use your domain for automatic HTTPS, e.g. paradox.example.com.
# For an IP-only demo use http://YOUR_ORACLE_PUBLIC_IP.
SITE_ADDRESS=http://YOUR_ORACLE_PUBLIC_IP
CORS_ORIGINS=http://YOUR_ORACLE_PUBLIC_IP

# Generate strong values before deployment; do not reuse these placeholders.
MONGO_ROOT_USERNAME=paradox
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-64-random-hex-characters
QR_MASTER_KEY=replace-with-urlsafe-base64-of-32-random-bytes

# Demo accounts intentionally share one password.
DEMO_ADMIN_EMAIL=paradox.admin@example.com
DEMO_PASSWORD=ParadoxDemo2026!

ACCESS_TOKEN_EXPIRE_MINUTES=10080
WEB_CONCURRENCY=2

# Optional AI recommendations (OpenRouter, OpenAI-compatible).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL=nvidia/nemotron-3-embed-1b:free
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
