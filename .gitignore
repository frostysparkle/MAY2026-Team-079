# Local editor configuration
.zed/
*.pdf
*.md
node_modules/

graphify-out/
graphify-out

__pycache__/
*.pyc

# Secrets. backend/atlas-credentials.env holds the MongoDB Atlas connection
# string (username, password, cluster host) and must never be committed.
# `*.example` templates are deliberately still tracked.
*.env
.env
!*.env.example

# Database dumps taken before destructive maintenance. They are full participant
# documents, so they carry password hashes and per-user RSA private keys and must
# never be committed. Safe to delete once the change they cover is settled.
.backups/
