# Use a MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.vknhbiv.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=paradox_connect
APP_ENV=development

# Use a randomly generated value of at least 32 characters. Never expose it to the frontend.
JWT_SECRET=
JWT_ISSUER=paradox-connect
JWT_ACCESS_TOKEN_MINUTES=30

# Optional. This account is invited as the first Super Admin and is activated
# once that account registers or signs in with email + password.
INITIAL_SUPER_ADMIN_EMAIL=

CORS_ORIGINS=http://localhost:5173

# Payments (Epic 10). The mock gateway ships by default for local/dev; a real
# provider (Razorpay/Stripe-style) plugs into the same interface later.
PAYMENT_GATEWAY=mock
# Real providers MUST set this to the provider's webhook signing secret. The
# mock gateway falls back to a dev value if unset.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=INR
HOSTEL_FEE_AMOUNT=2000
# Base URL the hosted-checkout redirect returns to (the frontend).
FRONTEND_BASE_URL=http://localhost:5173

# Dev/test only. Enables the /auth/dev-login + /auth/test-accounts endpoints and
# the frontend account switcher. Forced OFF when APP_ENV=production. Never set
# this to true in a production deployment.
ENABLE_DEV_LOGIN=false

# Required for QR provisioning and verification. Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QR_SECRET_ENCRYPTION_KEY=

# Required for shared QR replay protection and rate limiting.
REDIS_URL=redis://localhost:6379/0
QR_SCAN_RATE_LIMIT=10
QR_SCAN_RATE_WINDOW_SECONDS=60
