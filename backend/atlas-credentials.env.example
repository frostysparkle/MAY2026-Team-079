# Copy to atlas-credentials.env and fill in. Never commit the real file —
# .gitignore blocks *.env and only keeps these *.example templates tracked.

# MongoDB connection string (local mongod or an Atlas SRV string).
MONGODB_URI=mongodb://localhost:27017/paradox

# JWT signing key, 64 hex chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Access-token lifetime in minutes. Default if unset: 10080 (1 week).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
