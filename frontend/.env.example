# Copy to .env.local and fill in. All client-exposed vars must be prefixed VITE_.
# Never commit real secrets — .env.local is gitignored by Vite's *.local rule.

# Base URL of the backend API, INCLUDING the version prefix. The app always
# talks to this real backend, so it must be reachable in dev.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Dev-only account switcher for QA. Enabled by default in dev builds; set
# "false" to hide it. It never renders in a production build regardless.
VITE_ENABLE_DEV_SWITCHER=true
