# Copy to .env.local and fill in. All client-exposed vars must be prefixed VITE_.
# Never commit real secrets — .env.local is gitignored by Vite's *.local rule.

# Base URL of the backend API. With the mock layer enabled this is unused.
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client ID (from Google Cloud console). Mocked in dev.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Use the in-memory mock API instead of calling the real backend.
# "true" during Sprint 1 (no backend yet); set "false" once endpoints exist.
VITE_USE_MOCK_API=true
